generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  coach
  client
}

enum ClientStatus {
  potential
  active
  paused
}

enum ContractStatus {
  opportunity
  potential
  active
  lost
  finished
}

enum ContractType {
  retainer
  ongoing
  oneoff
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         Role     @default(client)
  passwordHash String?
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  createdAt    DateTime @default(now())
}

model Client {
  id            String          @id @default(cuid())
  slug          String?         @unique
  name          String
  agency        String?
  email         String          @unique
  status        ClientStatus    @default(active)
  startDate     String?
  endDate       String?
  projectionState String?       // JSON: saved Growth Projection input state
  users         User[]
  goal          Goal?
  metrics       MonthlyMetric[]
  contracts     Contract[]
  accounts      Account[]
  calls         Call[]
  products      Product[]
  roadmapItems  RoadmapItem[]
  people        Person[]
  monthlyChecklists MonthlyChecklist[]
  createdAt     DateTime        @default(now())
}

model Account {
  id           String     @id @default(cuid())
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  contactName  String?
  contactEmail String?
  notes        String?
  ownerId      String?    // account owner (AM); defaults to a project owner in the UI
  createdAt    DateTime   @default(now())
  contracts    Contract[]
  notesLog     AccountNote[]
}

model MonthlyMetric {
  id            String @id @default(cuid())
  clientId      String
  client        Client @relation(fields: [clientId], references: [id])
  month         String
  revenue       Float  @default(0)
  totalExpenses Float  @default(0)
  salaries      Float  @default(0)
  software      Float  @default(0)
  cashInBank    Float  @default(0)
  leads          Float  @default(0)
  newClients     Float  @default(0)
  closeRate       Float  @default(0)
  churn           Float  @default(0)
  marketingSpend  Float  @default(0)

  @@unique([clientId, month])
}

model Goal {
  id             String @id @default(cuid())
  clientId       String @unique
  client         Client @relation(fields: [clientId], references: [id])
  annualRevenue  Float  @default(0)
  profit         Float  @default(0)
  monthlyRevenue Float  @default(0)
  netProfitPct   Float  @default(0)
  closeRatePct   Float  @default(0)
  peoplePct      Float  @default(30)
  currency       String @default("USD")
  minHourlyRate  Float? // minimum acceptable $/hr, used to flag projects on the yield table
}

model Contract {
  id                String         @id @default(cuid())
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id])
  name              String
  monthly           Float
  hoursPerMonth     Float          @default(0)
  actualHours       Float?         // one-offs: real hours spent, vs hoursPerMonth (sold/projected)
  start             String
  contractedThrough String?
  status            ContractStatus @default(active)
  verbal            Boolean        @default(false) // pipeline: verbal yes, not yet signed/paid
  stageEnteredAt    DateTime?      @default(now()) // when the deal last changed pipeline stage
  updatedAt         DateTime       @updatedAt      // last edit of any kind
  type              ContractType   @default(retainer)
  accountId         String?
  productId         String?        // which Product (package) this project signed onto
  deliveryStart     String?        // one-offs: work window start (YYYY-MM), decoupled from payment
  deliveryEnd       String?        // one-offs: work window end (YYYY-MM)
  ownerId           String?        // Person who owns/manages this account
  account           Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  product           Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  callDate          String?
  signedDate        String?
  kickoffDate       String?
  createdAt         DateTime       @default(now())
  accountMonths     AccountMonth[]
  payments          ContractPayment[]
  hoursMonths       ContractHoursMonth[]
  deliveryMonths    ContractDeliveryMonth[]
  pulses            ContractPulse[]
  members           ProjectMember[]
  notesLog          ContractNote[]
}

// Monthly health "pulse" (1–5) per project — churn-risk signal (active projects).
model ContractPulse {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  month      String   // YYYY-MM
  score      Int      // 1–5
  note       String?
  createdAt  DateTime @default(now())

  @@unique([contractId, month])
}

model Person {
  id               String              @id @default(cuid())
  clientId         String
  client           Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name             String
  role             String?
  responsibilities String?
  isExternal       Boolean             @default(false)
  isFullTime       Boolean             @default(true)
  annualSalary     Float               @default(0)
  billableHours    Float               @default(0)
  startDate        String?
  endDate          String?
  createdAt        DateTime            @default(now())
  salaryMonths     PersonSalaryMonth[]
  hoursMonths      PersonHoursMonth[]
  projectMembers   ProjectMember[]
}

model PersonSalaryMonth {
  id            String   @id @default(cuid())
  personId      String
  person        Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  month         String
  monthlySalary Float
  createdAt     DateTime @default(now())

  @@unique([personId, month])
}

model PersonHoursMonth {
  id           String   @id @default(cuid())
  personId     String
  person       Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  month        String
  monthlyHours Float
  createdAt    DateTime @default(now())

  @@unique([personId, month])
}

model AccountMonth {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  month      String
  actual     Float
  createdAt  DateTime @default(now())

  @@unique([contractId, month])
}

model ContractPayment {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  month      String
  amount     Float
  note       String?
  createdAt  DateTime @default(now())

  @@unique([contractId, month])
}

// Actual hours spent on a project in a given month — for hourly-yield tracking.
model ContractHoursMonth {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  month      String   // YYYY-MM
  hours      Float

  @@unique([contractId, month])
}

// Planned/sold hours by month — the delivery (capacity) timeline, decoupled from payment.
// Primary use: one-offs whose work spans months. Retainers derive from hoursPerMonth.
model ContractDeliveryMonth {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  month      String   // YYYY-MM
  hours      Float

  @@unique([contractId, month])
}

model Call {
  id         String     @id @default(cuid())
  clientId   String
  client     Client     @relation(fields: [clientId], references: [id])
  date        String
  title       String
  transcript  String?
  video       String?
  synopsis    String?
  notes       String?
  isGroupCall Boolean    @default(false) // group call → visible to every client
  questions   Question[]
  createdAt   DateTime   @default(now())
}

model Question {
  id     String  @id @default(cuid())
  callId String
  call   Call    @relation(fields: [callId], references: [id], onDelete: Cascade)
  q      String
  a      String?
  order  Int
}

model IntakeSubmission {
  id        String   @id @default(cuid())
  email     String
  name      String?
  agency    String?
  data      String
  answers   String
  converted Boolean  @default(false)
  clientId  String?
  createdAt DateTime @default(now())
}

// Public "how many leads to hit your goal" calculator submissions (lead magnet).
model LeadGoalSubmission {
  id             String   @id @default(cuid())
  email          String
  name           String?
  agency         String?
  currency       String   @default("USD")
  inputs         String   // JSON: the numbers the visitor submitted
  result         String   // JSON: computed LeadsGoalResult snapshot at submit time
  adjustedInputs String?  // JSON: John's working-copy tweaks (never overwrites `inputs`)
  takeaways      String?  // John's editable notes for the report
  scheduled      Boolean  @default(false)
  reportSent     Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// Public "when does your agency cap out" calculator submissions (lead magnet).
model CapacityLead {
  id             String   @id @default(cuid())
  email          String
  name           String?
  agency         String?
  currency       String   @default("USD")
  inputs         String   // JSON: the numbers the visitor submitted
  result         String   // JSON: computed CapacityResult snapshot at submit time
  adjustedInputs String?  // JSON: John's working-copy tweaks (never overwrites `inputs`)
  takeaways      String?  // John's editable notes for the report
  scheduled      Boolean  @default(false)
  reportSent     Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Product {
  id          String       @id @default(cuid())
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        ContractType @default(retainer)
  monthly     Float
  createdAt   DateTime     @default(now())
  contracts   Contract[]
}

model RoadmapItem {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  key       String
  status    String   @default("none")
  createdAt DateTime @default(now())

  @@unique([clientId, key])
}

model InviteToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// People (incl. vendors) assigned to a project, with a per-project title.
model ProjectMember {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  role       String?  // per-project title, e.g. "Content Writer"
  createdAt  DateTime @default(now())

  @@unique([contractId, personId])
}

// Timestamped relationship notes on an account.
model AccountNote {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  body      String
  author    String?
  createdAt DateTime @default(now())
}

// Call notes & transcripts warehoused on a pipeline deal (or any project).
model ContractNote {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  body       String
  kind       String   @default("note") // note | transcript
  author     String?
  createdAt  DateTime @default(now())
}

// Dismissible start-of-month close-out checklist, per client per month.
model MonthlyChecklist {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month       String   // YYYY-MM the checklist is shown for
  dismissed   Boolean  @default(false)
  checkedKeys String   @default("[]") // JSON array of ticked item keys
  updatedAt   DateTime @updatedAt

  @@unique([clientId, month])
}
