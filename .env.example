DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-site.netlify.app"

# Capacity Calculator lead magnet
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/XXX/YYY/ZZZ"   # Slack incoming webhook for new-lead alerts
NEXT_PUBLIC_SCHEDULING_URL="https://calendly.com/your-link"        # where leads go after submitting
NEXT_PUBLIC_APP_URL="https://agencyos.johnfdoherty.com"            # used to build the review link in Slack
ALLOWED_EMBED_ORIGIN="*"                                          # or "https://johnfdoherty.com" to restrict the embed API

# Comma-separated client slugs allowed to see the Insights tab (phased rollout).
# Leave empty to hide it everywhere; add slugs to roll out gradually.
INSIGHTS_CLIENT_SLUGS=

# The Content Five (Tools). Server-side only — never shipped to the browser.
ANTHROPIC_API_KEY=
# Only needed if the key above is not scoped to a workspace (starts wrkspc_).
ANTHROPIC_WORKSPACE_ID=

# Package Architect (public lead tool at /package-architect)
ANTHROPIC_API_KEY="sk-ant-..."          # server-only; never NEXT_PUBLIC_, never in SECRETS_SCAN_OMIT_KEYS
# Optional overrides — change in Netlify env, no deploy needed:
# PA_BUILDS_PER_HOUR=5
# PA_BUILDS_PER_DAY=20
# PA_MAX_INPUT_CHARS=12000
# PA_MAX_OUTPUT_TOKENS=8000
# PA_EFFORT=medium                       # low | medium | high | xhigh | max
# RATE_LIMIT_SALT=                       # defaults to AUTH_SECRET
